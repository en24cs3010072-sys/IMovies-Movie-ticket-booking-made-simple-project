# Local MongoDB default: mongodb://127.0.0.1:27017/imovies
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# Replace this with a long random value before deploying.
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional: set when the frontend is hosted on a different origin.
# CLIENT_ORIGIN=http://localhost:5173
